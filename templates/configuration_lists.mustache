{{!
    @template enrol_select/configuration_lists

    Template Moodle pour afficher les listes d'inscription (statut de l'inscription).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * notification
    * lists
        * status
        * statusshort
        * listname
        * description
        * editurl

    Example context (json):
    {
        "notification": "Les valeur associés à la liste principale ont été modifiées.",
        "lists": [
            {
                "status": "accepté",
                "statusshort": "L. A.",
                "listname": "Liste des acceptés",
                "description": "Etudiants dont l’inscription est validée",
                "editurl": "https://apsolu.fr/apsolu/enrol/select/administration.php?tab=lists&editstate=0"
            }
        ]
    }
}}
{{#notification}}
	{{{notification}}}
{{/notification}}


<table class="table table-striped">
<thead>
	<tr>
		<th>{{#str}}enrol_status, enrol_select{{/str}}</th>
		<th>{{#str}}enrol_statusshort, enrol_select{{/str}}</th>
        <th>{{#str}}edit_listname, enrol_select{{/str}}</th>
        <th>{{#str}}edit_description, enrol_select{{/str}}</th>
        <th>{{#str}}actions{{/str}}</th>
	</tr>
</thead>
<tbody>
	{{#lists}}
	<tr>
		<td class="capitalize">{{status}}</td>
        <td>{{{statusshort}}}</td>
        <td  class="capitalize">{{{listname}}}</td>
        <td  class="capitalize">{{{description}}}</td>
        <td><a href="{{{editurl}}}">{{#pix}}t/edit,core,{{#str}}edit{{/str}}{{/pix}}</a></td>
	</tr>
	{{/lists}}
</tbody>
</table>

