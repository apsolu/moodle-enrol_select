{{!
    @template enrol_select/show_user_enrolments

    Template Moodle pour afficher la modale d'informations additionnelles sur les inscriptions d'un utilisateur.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * wwwroot correspond à la valeur de la variable Moodle $CFG->wwwroot
    
    Example context (json):
    {
        "wwwroot": "https://apsolu.fr",

    }
}}
{{#coursetypes}}

{{! L'onglet du format d'activité auquel correspond le cours actuellement affiché est ouvert par défaut, les autres sont fermés. }}
{{#currenttype}}
    <details open class="ue-course-format-details">
{{/currenttype}}

{{^currenttype}}
    <details class="ue-course-format-details">
{{/currenttype}}

        <summary class='capitalize'>{{name}}</summary>

        {{#enrolments}}
            <ul class="ue-course-format-details-content list-unstyled mb-0">
            {{#count_accepted_enrolments}}
            {{#accepted_enrolments}}
                <li>
                {{#courseurl}}
                    <p class="my-0"><span><a href="{{courseurl}}">{{coursefullname}}</a></span></p>
                    <p class="ms-5 my-0"><span class="badge bg-custom">{{#pix}}e/tick, core {{/pix}} accepté </span><span>{{enrolname}} - {{rolename}}</span>{{#editable}}<span><a href="{{enrolurl}}">{{#pix}}i/enrolusers, core {{/pix}}</a></span>{{/editable}}</p>
                {{/courseurl}}

                {{^courseurl}}
                    <p class="my-0 text-muted"><span>{{coursefullname}}</span><span><a href="" data-action="hide">{{#str}}current_page, enrol_select{{/str}}</a></span></p>
                    <p class="ms-5 my-0 text-muted"><span class="badge bg-custom">{{#pix}}e/tick, core {{/pix}} accepté </span><span>{{enrolname}} - {{rolename}}</span></p>
                {{/courseurl}}
                </li>
            {{/accepted_enrolments}}
            {{/count_accepted_enrolments}}
            {{#count_other_enrolments}}
            {{#other_enrolments}}
                <li>
                {{#courseurl}}
                    <p class="my-0"><span><a href="{{courseurl}}">{{coursefullname}}</a></span></p>
                    <p class="ms-5 my-0"><span class="badge bg-{{statuslevel}}">{{status}}</span><span>{{enrolname}} - {{rolename}}</span>{{#editable}}<span><a href="{{enrolurl}}">{{#pix}}i/enrolusers, core {{/pix}}</a></span>{{/editable}}</p>
                {{/courseurl}}

                {{^courseurl}}
                    <p class="my-0"><span class="text-muted">{{coursefullname}}</span><span><a href="" data-action="hide">{{#str}}current_page, enrol_select{{/str}}</a></span></p>
                    <p class="ms-5 my-0 text-muted"><span class="badge bg-{{statuslevel}}">{{status}}</span><span>{{enrolname}} - {{rolename}}</span></p>
                {{/courseurl}}
                
                </li>
            {{/other_enrolments}}
            {{/count_other_enrolments}}
            </ul>
        {{/enrolments}}


    </details>
{{/coursetypes}}

{{#federation_adhesion}}
{{#ffsu_licence_number}}
<div class="ue-course-ffsu">
    <p class="fw-semibold mb-1">{{#str}}membership_of_the_sports_association, local_apsolu{{/str}}</p>
    <p class="mb-0 ms-3">{{#str}}federation_licenseid, local_apsolu{{/str}} : {{ffsu_licence_number}}</p>
    <p class="mb-0 ms-3">{{#str}}license_number_status, local_apsolu{{/str}} : {{ffsu_licence_status}}</p>
 </div>
 {{/ffsu_licence_number}}
 {{/federation_adhesion}}